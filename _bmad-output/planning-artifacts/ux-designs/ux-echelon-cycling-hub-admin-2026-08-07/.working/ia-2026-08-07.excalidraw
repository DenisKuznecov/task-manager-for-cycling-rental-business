    {"id":"attention-request-text","type":"text","x":910,"y":752,"width":600,"height":190,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1059,"version":1,"versionNonce":2059,"isDeleted":false,"boundElements":[],"updated":1786111200000,"link":null,"locked":false,"index":"bM","text":"ATTENTION REQUEST (from active task)\n1. Same-mechanic Re-check override — no explanation\n   → blocks only requester from claiming Re-check\n2. Missing / unclear bike or order info — explanation required\n   → task remains workable + visibly flagged\n3. Manager decision needed — explanation required\n   → task remains workable + visibly flagged","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"ATTENTION REQUEST (from active task)\n1. Same-mechanic Re-check override — no explanation\n   → blocks only requester from claiming Re-check\n2. Missing / unclear bike or order info — explanation required\n   → task remains workable + visibly flagged\n3. Manager decision needed — explanation required\n   → task remains workable + visibly flagged","lineHeight":1.3},
